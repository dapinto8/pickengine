# Copy to .env (gitignored) and fill in. Loaded automatically by the CLI;
# real environment variables take precedence over these values.

# The Odds API key (the-odds-api.com) — required for pull-odds and daily.
ODDS_API_KEY=

# SQLite database file. Optional; defaults to ./pickengine.db.
# PICKENGINE_DB=./pickengine.db
